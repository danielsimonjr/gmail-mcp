{
  "name": "gmail-mcp",
  "version": "0.3.2",
  "private": true,
  "description": "Gmail-mcp: MCP server for Gmail with sorting, attachments, drafts, and pagination",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "dist/index.js",
    "gmail-mcp-auth": "dist/auth-cli.js"
  },
  "scripts": {
